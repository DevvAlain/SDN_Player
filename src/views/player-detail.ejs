<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= player.playerName %> - Player Details
    </title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
</head>

<body>
    <%- include('partials/header') %>

        <!-- Player Hero Section -->
        <section class="player-hero">
            <div class="container">
                <div class="player-hero-content">
                    <div class="player-image-section">
                        <div class="player-image-container-large">
                            <img src="<%= player.image %>" alt="<%= player.playerName %>" class="player-image-large"
                                onerror="this.src='/images/default-player.jpg'">
                            <% if (player.isCaptain) { %>
                                <div class="captain-badge-large">
                                    <i class="fas fa-crown captain-crown"></i>
                                    <span>Captain</span>
                                </div>
                                <% } %>
                        </div>
                    </div>

                    <div class="player-info-section">
                        <h1 class="player-title">
                            <%= player.playerName %>
                                <% if (player.isCaptain) { %>
                                    <i class="fas fa-crown captain-crown-title"></i>
                                    <% } %>
                        </h1>

                        <div class="player-meta">
                            <div class="meta-item">
                                <i class="fas fa-shield-alt"></i>
                                <span class="meta-label">Team:</span>
                                <span class="meta-value">
                                    <%= player.team ? player.team.teamName : 'No Team' %>
                                </span>
                            </div>

                            <div class="meta-item">
                                <i class="fas fa-dollar-sign"></i>
                                <span class="meta-label">Value:</span>
                                <span class="meta-value">$<%= player.cost ? player.cost.toLocaleString() : '0' %></span>
                            </div>

                            <div class="meta-item">
                                <i class="fas fa-star"></i>
                                <span class="meta-label">Rating:</span>
                                <div class="player-rating-large">
                                    <% let averageRating=0; if (player.comments && player.comments.length> 0) {
                                        averageRating = player.comments.reduce((sum, comment) => sum + comment.rating,
                                        0) / player.comments.length;
                                        }
                                        %>
                                        <div class="rating-stars-large">
                                            <% for (let i=1; i <=3; i++) { %>
                                                <i
                                                    class="fas fa-star star-large <%= i <= Math.round(averageRating) ? '' : 'inactive' %>"></i>
                                                <% } %>
                                        </div>
                                        <span class="rating-text-large">
                                            <%= averageRating.toFixed(1) %>/3 (<%= player.comments ?
                                                    player.comments.length : 0 %> reviews)
                                        </span>
                                </div>
                            </div>
                        </div>

                        <div class="player-actions-hero">
                            <% if (user && user.isAdmin) { %>
                                <a href="/admin/players/edit/<%= player._id %>" class="btn btn-warning">
                                    <i class="fas fa-edit"></i>
                                    Edit Player
                                </a>
                                <% } %>
                                    <a href="/" class="btn btn-secondary">
                                        <i class="fas fa-arrow-left"></i>
                                        Back to Players
                                    </a>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Player Information -->
        <section class="player-details">
            <div class="container">
                <%- include('partials/messages') %>

                    <div class="details-grid">
                        <!-- Player Information Card -->
                        <div class="card info-card">
                            <div class="card-header">
                                <h2 class="card-title">
                                    <i class="fas fa-info-circle"></i>
                                    Player Information
                                </h2>
                            </div>
                            <div class="card-body">
                                <div class="info-item">
                                    <h3>About</h3>
                                    <p>
                                        <%= player.infomation || 'No information available.' %>
                                    </p>
                                </div>

                                <div class="info-stats">
                                    <div class="stat-item">
                                        <i class="fas fa-calendar-alt"></i>
                                        <div>
                                            <span class="stat-label">Joined</span>
                                            <span class="stat-value">
                                                <%= new Date(player.createdAt).toLocaleDateString() %>
                                            </span>
                                        </div>
                                    </div>

                                    <div class="stat-item">
                                        <i class="fas fa-comments"></i>
                                        <div>
                                            <span class="stat-label">Reviews</span>
                                            <span class="stat-value">
                                                <%= player.comments ? player.comments.length : 0 %>
                                            </span>
                                        </div>
                                    </div>

                                    <div class="stat-item">
                                        <i class="fas fa-trophy"></i>
                                        <div>
                                            <span class="stat-label">Status</span>
                                            <span
                                                class="stat-value <%= player.isCaptain ? 'status-captain' : 'status-player' %>">
                                                <%= player.isCaptain ? 'Captain' : 'Player' %>
                                            </span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Comment Form Card (for logged in users) -->
                        <% if (user) { %>
                            <div class="card comment-form-card" id="comment-form">
                                <div class="card-header">
                                    <h2 class="card-title">
                                        <i class="fas fa-star"></i>
                                        Rate & Review
                                    </h2>
                                </div>
                                <div class="card-body">
                                    <% const userComment=player.comments ? player.comments.find(c=> c.author &&
                                        c.author._id && c.author._id.toString() === user._id.toString()) : null;
                                        %>
                                        <% if (userComment) { %>
                                            <div class="existing-comment">
                                                <div class="alert alert-info">
                                                    <i class="fas fa-info-circle"></i>
                                                    You have already reviewed this player. You can update your review
                                                    below.
                                                </div>

                                                <div class="current-review">
                                                    <h4>Your Current Review:</h4>
                                                    <div class="rating-display">
                                                        <div class="rating-stars">
                                                            <% for (let i=1; i <=3; i++) { %>
                                                                <i
                                                                    class="fas fa-star star <%= i <= userComment.rating ? '' : 'inactive' %>"></i>
                                                                <% } %>
                                                        </div>
                                                        <span class="rating-text">(<%= userComment.rating %>/3)</span>
                                                    </div>
                                                    <p class="comment-content">
                                                        <%= userComment.content %>
                                                    </p>
                                                    <small class="comment-date">
                                                        <i class="fas fa-clock"></i>
                                                        <%= new Date(userComment.createdAt).toLocaleDateString() %>
                                                    </small>
                                                </div>
                                            </div>
                                            <% } %>

                                                <form action="/players/<%= player._id %>/comments" method="POST"
                                                    class="comment-form">
                                                    <div class="form-group">
                                                        <label class="form-label">
                                                            <i class="fas fa-star"></i>
                                                            Rating (1-3 stars)
                                                        </label>
                                                        <div class="rating-input">
                                                            <% for (let i=1; i <=3; i++) { %>
                                                                <input type="radio" id="rating-<%= i %>" name="rating"
                                                                    value="<%= i %>" <%=userComment &&
                                                                    userComment.rating===i ? 'checked' : '' %>
                                                                required>
                                                                <label for="rating-<%= i %>" class="rating-label">
                                                                    <i class="fas fa-star"></i>
                                                                </label>
                                                                <% } %>
                                                        </div>
                                                        <small class="form-text">Select a rating from 1 to 3
                                                            stars</small>
                                                    </div>

                                                    <div class="form-group">
                                                        <label for="content" class="form-label">
                                                            <i class="fas fa-comment"></i>
                                                            Your Review
                                                        </label>
                                                        <textarea id="content" name="content" class="form-control"
                                                            rows="4"
                                                            placeholder="Share your thoughts about this player..."
                                                            required><%= userComment ? userComment.content : '' %></textarea>
                                                    </div>

                                                    <button type="submit" class="btn btn-primary btn-block">
                                                        <i class="fas fa-paper-plane"></i>
                                                        <%= userComment ? 'Update Review' : 'Submit Review' %>
                                                    </button>
                                                </form>
                                </div>
                            </div>
                            <% } else { %>
                                <div class="card login-prompt-card">
                                    <div class="card-body text-center">
                                        <i class="fas fa-sign-in-alt login-icon"></i>
                                        <h3>Want to Review?</h3>
                                        <p>Login to share your thoughts and rate this player.</p>
                                        <div class="login-actions">
                                            <a href="/login" class="btn btn-primary">
                                                <i class="fas fa-sign-in-alt"></i>
                                                Login
                                            </a>
                                            <a href="/register" class="btn btn-secondary">
                                                <i class="fas fa-user-plus"></i>
                                                Register
                                            </a>
                                        </div>
                                    </div>
                                </div>
                                <% } %>
                    </div>
            </div>
        </section>

        <!-- Comments Section -->
        <section class="comments-section">
            <div class="container">
                <div class="comments-header">
                    <h2 class="section-title">
                        <i class="fas fa-comments"></i>
                        Reviews & Ratings
                        <span class="comments-count">(<%= player.comments ? player.comments.length : 0 %>)</span>
                    </h2>

                    <% if (player.comments && player.comments.length> 0) { %>
                        <div class="rating-summary">
                            <div class="overall-rating">
                                <span class="rating-number">
                                    <%= averageRating.toFixed(1) %>
                                </span>
                                <div class="rating-stars">
                                    <% for (let i=1; i <=3; i++) { %>
                                        <i
                                            class="fas fa-star star <%= i <= Math.round(averageRating) ? '' : 'inactive' %>"></i>
                                        <% } %>
                                </div>
                                <span class="rating-label">out of 3</span>
                            </div>

                            <div class="rating-breakdown">
                                <% for (let i=3; i>= 1; i--) { %>
                                    <div class="rating-bar">
                                        <span class="bar-label">
                                            <%= i %> star
                                        </span>
                                        <div class="bar-container">
                                            <% const ratingCount=player.comments.filter(c=> c.rating === i).length;
                                                const percentage = player.comments.length > 0 ? (ratingCount /
                                                player.comments.length) * 100 : 0;
                                                %>
                                                <div class="bar-fill" data-percentage="<%= percentage %>"></div>
                                        </div>
                                        <span class="bar-count">
                                            <%= ratingCount %>
                                        </span>
                                    </div>
                                    <% } %>
                            </div>
                        </div>
                        <% } %>
                </div>

                <div class="comments-list">
                    <% if (player.comments && player.comments.length> 0) { %>
                        <% player.comments.forEach(comment=> { %>
                            <div class="comment-card">
                                <div class="comment-header">
                                    <div class="comment-author">
                                        <div class="author-avatar">
                                            <i class="fas fa-user"></i>
                                        </div>
                                        <div class="author-info">
                                            <h4 class="author-name">
                                                <%= comment.author ? comment.author.name : 'Anonymous' %>
                                            </h4>
                                            <div class="comment-rating">
                                                <div class="rating-stars">
                                                    <% for (let i=1; i <=3; i++) { %>
                                                        <i
                                                            class="fas fa-star star <%= i <= comment.rating ? '' : 'inactive' %>"></i>
                                                        <% } %>
                                                </div>
                                                <span class="rating-text">(<%= comment.rating %>/3)</span>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="comment-meta">
                                        <span class="comment-date">
                                            <i class="fas fa-clock"></i>
                                            <%= new Date(comment.createdAt).toLocaleDateString() %>
                                        </span>

                                        <% if (user && (user.isAdmin || (comment.author &&
                                            user._id.toString()===comment.author._id.toString()))) { %>
                                            <form
                                                action="/players/<%= player._id %>/comments/<%= comment._id %>?_method=DELETE"
                                                method="POST" class="delete-form" style="display: inline">
                                                <button type="submit" class="btn-delete"
                                                    onclick="return confirm('Are you sure you want to delete this comment?')">
                                                    <i class="fas fa-trash"></i>
                                                </button>
                                            </form>
                                            <% } %>
                                    </div>
                                </div>

                                <div class="comment-content">
                                    <p>
                                        <%= comment.content %>
                                    </p>
                                </div>
                            </div>
                            <% }) %>
                                <% } else { %>
                                    <div class="no-comments">
                                        <div class="no-comments-icon">
                                            <i class="fas fa-comment-slash"></i>
                                        </div>
                                        <h3>No Reviews Yet</h3>
                                        <p>Be the first to share your thoughts about this player!</p>
                                        <% if (user) { %>
                                            <a href="#comment-form" class="btn btn-primary">
                                                <i class="fas fa-star"></i>
                                                Write First Review
                                            </a>
                                            <% } %>
                                    </div>
                                    <% } %>
                </div>
            </div>
        </section>

        <%- include('partials/footer') %>

            <script>
                // Rating input interaction
                const ratingInputs = document.querySelectorAll('.rating-input input[type="radio"]');
                const ratingLabels = document.querySelectorAll('.rating-input .rating-label');

                ratingLabels.forEach((label, index) => {
                    label.addEventListener('mouseenter', function () {
                        highlightStars(index + 1);
                    });

                    label.addEventListener('click', function () {
                        ratingInputs[index].checked = true;
                        highlightStars(index + 1);
                    });
                });

                document.querySelector('.rating-input').addEventListener('mouseleave', function () {
                    const checkedRating = document.querySelector('.rating-input input[type="radio"]:checked');
                    if (checkedRating) {
                        highlightStars(parseInt(checkedRating.value));
                    } else {
                        highlightStars(0);
                    }
                });

                function highlightStars(rating) {
                    ratingLabels.forEach((label, index) => {
                        const star = label.querySelector('i');
                        if (index < rating) {
                            star.classList.remove('inactive');
                            star.classList.add('active');
                        } else {
                            star.classList.add('inactive');
                            star.classList.remove('active');
                        }
                    });
                }

                // Initialize rating display
                const checkedRating = document.querySelector('.rating-input input[type="radio"]:checked');
                if (checkedRating) {
                    highlightStars(parseInt(checkedRating.value));
                }

                // Smooth scroll to comment form
                document.querySelectorAll('a[href="#comment-form"]').forEach(link => {
                    link.addEventListener('click', function (e) {
                        e.preventDefault();
                        document.getElementById('comment-form').scrollIntoView({
                            behavior: 'smooth'
                        });
                    });
                });

                // Form validation
                const commentForm = document.querySelector('.comment-form');
                if (commentForm) {
                    commentForm.addEventListener('submit', function (e) {
                        const rating = document.querySelector('.rating-input input[type="radio"]:checked');
                        const content = document.getElementById('content');

                        if (!rating) {
                            e.preventDefault();
                            alert('Please select a rating.');
                            return;
                        }

                        if (!content.value.trim()) {
                            e.preventDefault();
                            alert('Please write a review.');
                            return;
                        }
                    });
                }

                // Delete confirmation with better UX
                document.querySelectorAll('.delete-form').forEach(form => {
                    form.addEventListener('submit', function (e) {
                        e.preventDefault();

                        if (confirm('Are you sure you want to delete this review? This action cannot be undone.')) {
                            // Add loading state
                            const deleteBtn = this.querySelector('.btn-delete');
                            deleteBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i>';
                            deleteBtn.disabled = true;

                            // Submit form
                            setTimeout(() => {
                                this.submit();
                            }, 500);
                        }
                    });
                });

                // Add loading animation to page elements
                document.addEventListener('DOMContentLoaded', function () {
                    const elements = document.querySelectorAll('.card, .comment-card');
                    elements.forEach((element, index) => {
                        setTimeout(() => {
                            element.classList.add('fade-in-up');
                        }, index * 100);
                    });

                    // Set rating bar widths
                    const barFills = document.querySelectorAll('.bar-fill');
                    barFills.forEach(bar => {
                        const percentage = bar.dataset.percentage;
                        if (percentage !== undefined) {
                            bar.style.width = percentage + '%';
                        }
                    });
                });
            </script>

            <style>
                /* Player Hero Section */
                .player-hero {
                    background: linear-gradient(135deg, rgba(102, 126, 234, 0.1) 0%, rgba(118, 75, 162, 0.1) 100%);
                    padding: 3rem 0;
                    margin-bottom: 3rem;
                }

                .player-hero-content {
                    display: grid;
                    grid-template-columns: 1fr 2fr;
                    gap: 3rem;
                    align-items: center;
                }

                .player-image-container-large {
                    position: relative;
                    border-radius: var(--border-radius-xl);
                    overflow: hidden;
                    box-shadow: var(--shadow-2xl);
                }

                .player-image-large {
                    width: 100%;
                    height: 400px;
                    object-fit: cover;
                    transition: transform 0.3s ease;
                }

                .player-image-large:hover {
                    transform: scale(1.05);
                }

                .captain-badge-large {
                    position: absolute;
                    top: 1.5rem;
                    right: 1.5rem;
                    background: rgba(245, 158, 11, 0.9);
                    color: white;
                    padding: 0.75rem 1.5rem;
                    border-radius: var(--border-radius-xl);
                    font-size: 1rem;
                    font-weight: 600;
                    text-transform: uppercase;
                    letter-spacing: 0.5px;
                    backdrop-filter: blur(10px);
                    border: 1px solid rgba(255, 255, 255, 0.2);
                    display: flex;
                    align-items: center;
                    gap: 0.75rem;
                    animation: glow 2s ease-in-out infinite alternate;
                }

                .player-title {
                    font-size: 3rem;
                    font-weight: 800;
                    background: var(--primary-gradient);
                    -webkit-background-clip: text;
                    -webkit-text-fill-color: transparent;
                    background-clip: text;
                    margin-bottom: 2rem;
                    display: flex;
                    align-items: center;
                    gap: 1rem;
                }

                .captain-crown-title {
                    color: #f59e0b;
                    animation: bounce 2s infinite;
                }

                .player-meta {
                    display: flex;
                    flex-direction: column;
                    gap: 1.5rem;
                    margin-bottom: 2rem;
                }

                .meta-item {
                    display: flex;
                    align-items: center;
                    gap: 1rem;
                    padding: 1rem;
                    background: var(--glass-bg);
                    border-radius: var(--border-radius);
                    backdrop-filter: blur(10px);
                }

                .meta-item i {
                    color: #667eea;
                    font-size: 1.2rem;
                    width: 24px;
                    text-align: center;
                }

                .meta-label {
                    font-weight: 600;
                    color: var(--text-secondary);
                    min-width: 60px;
                }

                .meta-value {
                    font-weight: 700;
                    color: var(--text-primary);
                }

                .player-rating-large {
                    display: flex;
                    align-items: center;
                    gap: 1rem;
                }

                .rating-stars-large {
                    display: flex;
                    gap: 0.25rem;
                }

                .star-large {
                    color: #fbbf24;
                    font-size: 1.5rem;
                    filter: drop-shadow(0 1px 2px rgba(251, 191, 36, 0.5));
                }

                .star-large.inactive {
                    color: #d1d5db;
                    filter: none;
                }

                .rating-text-large {
                    color: var(--text-secondary);
                    font-weight: 600;
                }

                .player-actions-hero {
                    display: flex;
                    gap: 1rem;
                    flex-wrap: wrap;
                }

                /* Details Grid */
                .details-grid {
                    display: grid;
                    grid-template-columns: 2fr 1fr;
                    gap: 2rem;
                    margin-bottom: 3rem;
                }

                .info-card .card-header {
                    background: var(--primary-gradient);
                    color: white;
                    padding: 1.5rem;
                    border-radius: var(--border-radius-lg) var(--border-radius-lg) 0 0;
                    margin: -2rem -2rem 2rem -2rem;
                }

                .card-header .card-title {
                    margin: 0;
                    display: flex;
                    align-items: center;
                    gap: 0.75rem;
                    color: white;
                }

                .info-item h3 {
                    color: var(--text-primary);
                    margin-bottom: 1rem;
                    font-weight: 600;
                }

                .info-item p {
                    color: var(--text-secondary);
                    line-height: 1.6;
                    margin-bottom: 2rem;
                }

                .info-stats {
                    display: flex;
                    flex-direction: column;
                    gap: 1rem;
                }

                .stat-item {
                    display: flex;
                    align-items: center;
                    gap: 1rem;
                    padding: 1rem;
                    background: rgba(102, 126, 234, 0.05);
                    border-radius: var(--border-radius);
                    border-left: 4px solid #667eea;
                }

                .stat-item i {
                    color: #667eea;
                    font-size: 1.2rem;
                    width: 24px;
                    text-align: center;
                }

                .stat-label {
                    display: block;
                    color: var(--text-secondary);
                    font-size: 0.9rem;
                    font-weight: 500;
                }

                .stat-value {
                    display: block;
                    color: var(--text-primary);
                    font-weight: 700;
                    font-size: 1.1rem;
                }

                .status-captain {
                    color: #f59e0b !important;
                }

                .status-player {
                    color: #10b981 !important;
                }

                /* Comment Form */
                .comment-form-card .card-header {
                    background: var(--success-gradient);
                    color: white;
                    padding: 1.5rem;
                    border-radius: var(--border-radius-lg) var(--border-radius-lg) 0 0;
                    margin: -2rem -2rem 2rem -2rem;
                }

                .existing-comment {
                    margin-bottom: 2rem;
                }

                .current-review {
                    background: rgba(102, 126, 234, 0.05);
                    padding: 1.5rem;
                    border-radius: var(--border-radius);
                    border-left: 4px solid #667eea;
                }

                .current-review h4 {
                    margin-bottom: 1rem;
                    color: var(--text-primary);
                }

                .rating-display {
                    display: flex;
                    align-items: center;
                    gap: 0.5rem;
                    margin-bottom: 1rem;
                }

                .comment-content {
                    margin-bottom: 0.5rem;
                    color: var(--text-secondary);
                    font-style: italic;
                }

                .comment-date {
                    color: var(--text-light);
                    display: flex;
                    align-items: center;
                    gap: 0.5rem;
                }

                .rating-input {
                    display: flex;
                    gap: 0.5rem;
                    margin-bottom: 0.5rem;
                }

                .rating-input input[type="radio"] {
                    display: none;
                }

                .rating-label {
                    cursor: pointer;
                    transition: all 0.2s ease;
                }

                .rating-label i {
                    font-size: 1.5rem;
                    color: #d1d5db;
                    transition: all 0.2s ease;
                }

                .rating-label:hover i,
                .rating-label i.active {
                    color: #fbbf24;
                    transform: scale(1.1);
                    filter: drop-shadow(0 2px 4px rgba(251, 191, 36, 0.5));
                }

                .form-text {
                    color: var(--text-light);
                    font-size: 0.85rem;
                    margin-top: 0.5rem;
                }

                .btn-block {
                    width: 100%;
                }

                /* Login Prompt */
                .login-prompt-card {
                    text-align: center;
                }

                .login-icon {
                    font-size: 3rem;
                    color: #667eea;
                    margin-bottom: 1rem;
                }

                .login-prompt-card h3 {
                    margin-bottom: 1rem;
                    color: var(--text-primary);
                }

                .login-prompt-card p {
                    color: var(--text-secondary);
                    margin-bottom: 2rem;
                }

                .login-actions {
                    display: flex;
                    gap: 1rem;
                    justify-content: center;
                }

                /* Comments Section */
                .comments-header {
                    display: flex;
                    justify-content: space-between;
                    align-items: flex-start;
                    margin-bottom: 2rem;
                    gap: 2rem;
                }

                .comments-count {
                    color: var(--text-light);
                    font-weight: 500;
                }

                .rating-summary {
                    background: var(--glass-bg);
                    backdrop-filter: blur(16px);
                    border-radius: var(--border-radius-lg);
                    padding: 2rem;
                    min-width: 300px;
                }

                .overall-rating {
                    text-align: center;
                    margin-bottom: 2rem;
                }

                .rating-number {
                    font-size: 3rem;
                    font-weight: 800;
                    background: var(--primary-gradient);
                    -webkit-background-clip: text;
                    -webkit-text-fill-color: transparent;
                    background-clip: text;
                    display: block;
                }

                .rating-label {
                    color: var(--text-secondary);
                    font-size: 0.9rem;
                }

                .rating-breakdown {
                    display: flex;
                    flex-direction: column;
                    gap: 0.75rem;
                }

                .rating-bar {
                    display: flex;
                    align-items: center;
                    gap: 1rem;
                }

                .bar-label {
                    min-width: 50px;
                    font-size: 0.9rem;
                    color: var(--text-secondary);
                }

                .bar-container {
                    flex: 1;
                    height: 8px;
                    background: rgba(102, 126, 234, 0.1);
                    border-radius: 4px;
                    overflow: hidden;
                }

                .bar-fill {
                    height: 100%;
                    background: var(--primary-gradient);
                    transition: width 0.5s ease;
                }

                .bar-count {
                    min-width: 30px;
                    text-align: right;
                    font-size: 0.9rem;
                    color: var(--text-secondary);
                }

                /* Comment Cards */
                .comments-list {
                    display: flex;
                    flex-direction: column;
                    gap: 1.5rem;
                }

                .comment-card {
                    background: var(--glass-bg);
                    backdrop-filter: blur(16px);
                    border: 1px solid var(--glass-border);
                    border-radius: var(--border-radius-lg);
                    box-shadow: var(--shadow-md);
                    padding: 2rem;
                    transition: all 0.3s ease;
                }

                .comment-card:hover {
                    transform: translateY(-2px);
                    box-shadow: var(--shadow-lg);
                }

                .comment-header {
                    display: flex;
                    justify-content: space-between;
                    align-items: flex-start;
                    margin-bottom: 1rem;
                }

                .comment-author {
                    display: flex;
                    align-items: flex-start;
                    gap: 1rem;
                }

                .author-avatar {
                    width: 50px;
                    height: 50px;
                    border-radius: 50%;
                    background: var(--primary-gradient);
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    color: white;
                    font-size: 1.2rem;
                }

                .author-name {
                    margin-bottom: 0.5rem;
                    color: var(--text-primary);
                    font-size: 1.1rem;
                }

                .comment-rating {
                    display: flex;
                    align-items: center;
                    gap: 0.5rem;
                }

                .comment-meta {
                    display: flex;
                    align-items: center;
                    gap: 1rem;
                }

                .btn-delete {
                    background: none;
                    border: none;
                    color: #ef4444;
                    cursor: pointer;
                    padding: 0.5rem;
                    border-radius: var(--border-radius);
                    transition: all 0.2s ease;
                }

                .btn-delete:hover {
                    background: rgba(239, 68, 68, 0.1);
                    transform: scale(1.1);
                }

                .comment-content p {
                    color: var(--text-secondary);
                    line-height: 1.6;
                    margin: 0;
                }

                /* No Comments */
                .no-comments {
                    text-align: center;
                    padding: 4rem 2rem;
                    background: var(--glass-bg);
                    backdrop-filter: blur(16px);
                    border-radius: var(--border-radius-lg);
                }

                .no-comments-icon {
                    font-size: 4rem;
                    color: var(--text-light);
                    margin-bottom: 1.5rem;
                }

                .no-comments h3 {
                    margin-bottom: 1rem;
                    color: var(--text-primary);
                }

                .no-comments p {
                    color: var(--text-secondary);
                    margin-bottom: 2rem;
                }

                /* Responsive Design */
                @media (max-width: 768px) {
                    .player-hero-content {
                        grid-template-columns: 1fr;
                        gap: 2rem;
                        text-align: center;
                    }

                    .player-image-large {
                        height: 300px;
                    }

                    .player-title {
                        font-size: 2rem;
                        flex-direction: column;
                        gap: 0.5rem;
                    }

                    .details-grid {
                        grid-template-columns: 1fr;
                        gap: 1.5rem;
                    }

                    .comments-header {
                        flex-direction: column;
                        gap: 1rem;
                    }

                    .rating-summary {
                        min-width: auto;
                        width: 100%;
                    }

                    .player-actions-hero {
                        justify-content: center;
                    }

                    .login-actions {
                        flex-direction: column;
                        align-items: center;
                    }

                    .comment-header {
                        flex-direction: column;
                        gap: 1rem;
                    }

                    .comment-meta {
                        justify-content: space-between;
                        width: 100%;
                    }
                }
            </style>
</body>

</html>