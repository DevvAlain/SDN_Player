<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Football Manager - Players</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap"
        rel="stylesheet">
    <style>
        /* Modern Players Page Styles */
        .modern-players-page {
            background: linear-gradient(135deg, #0ea5e9 0%, #0284c7 25%, #0369a1 50%, #1e40af 75%, #1e3a8a 100%);
            background-attachment: fixed;
            min-height: 100vh;
            padding: 2rem 0;
        }

        .page-header {
            text-align: center;
            margin-bottom: 3rem;
            padding: 2rem 0;
        }

        .page-title {
            font-size: 2.5rem;
            font-weight: 900;
            color: white;
            margin-bottom: 1rem;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 1rem;
        }

        .page-title i {
            background: linear-gradient(135deg, #06b6d4, #3b82f6);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .page-subtitle {
            font-size: 1.1rem;
            color: rgba(255, 255, 255, 0.8);
            max-width: 600px;
            margin: 0 auto;
        }

        /* Enhanced Search & Filter Section */
        .search-filter-section {
            background: rgba(255, 255, 255, 0.1);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.2);
            border-radius: 25px;
            padding: 2rem;
            margin-bottom: 3rem;
            box-shadow: 0 15px 35px rgba(0, 0, 0, 0.1);
        }

        .search-controls {
            display: grid;
            grid-template-columns: 2fr 1fr auto;
            gap: 1.5rem;
            align-items: end;
        }

        .search-group {
            position: relative;
        }

        .search-label {
            display: block;
            color: white;
            font-weight: 600;
            margin-bottom: 0.5rem;
            font-size: 0.9rem;
        }

        .modern-search-input {
            width: 100%;
            padding: 1rem 1rem 1rem 3rem;
            border: 2px solid rgba(255, 255, 255, 0.2);
            border-radius: 15px;
            background: rgba(255, 255, 255, 0.9);
            font-size: 1rem;
            font-weight: 500;
            color: #1f2937;
            transition: all 0.3s ease;
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
        }

        .modern-search-input:focus {
            outline: none;
            border-color: #3b82f6;
            background: rgba(255, 255, 255, 1);
            box-shadow: 0 0 0 4px rgba(59, 130, 246, 0.1);
            transform: translateY(-2px);
        }

        .search-icon {
            position: absolute;
            left: 1rem;
            bottom: 1rem;
            color: #6b7280;
            font-size: 1.1rem;
        }

        .filter-group {
            position: relative;
        }

        .modern-select {
            width: 100%;
            padding: 1rem 3rem 1rem 1rem;
            border: 2px solid rgba(255, 255, 255, 0.2);
            border-radius: 15px;
            background: rgba(255, 255, 255, 0.9);
            font-size: 1rem;
            font-weight: 500;
            color: #1f2937;
            cursor: pointer;
            transition: all 0.3s ease;
            appearance: none;
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
        }

        .modern-select:focus {
            outline: none;
            border-color: #3b82f6;
            background: rgba(255, 255, 255, 1);
            box-shadow: 0 0 0 4px rgba(59, 130, 246, 0.1);
        }

        .select-arrow {
            position: absolute;
            right: 1rem;
            bottom: 1rem;
            color: #6b7280;
            pointer-events: none;
        }

        .search-btn {
            padding: 1rem 2rem;
            background: linear-gradient(135deg, #3b82f6, #2563eb);
            color: white;
            border: none;
            border-radius: 15px;
            font-weight: 700;
            font-size: 1rem;
            cursor: pointer;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            gap: 0.75rem;
            box-shadow: 0 8px 25px rgba(59, 130, 246, 0.4);
        }

        .search-btn:hover {
            transform: translateY(-3px);
            box-shadow: 0 15px 40px rgba(59, 130, 246, 0.6);
        }

        /* Enhanced Players Grid */
        .players-container {
            max-width: 1400px;
            margin: 0 auto;
        }

        .players-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(320px, 380px));
            gap: 2rem;
            justify-content: center;
            align-items: start;
        }

        .player-card {
            background: rgba(255, 255, 255, 0.15);
            backdrop-filter: blur(25px);
            -webkit-backdrop-filter: blur(25px);
            border: 1px solid rgba(255, 255, 255, 0.2);
            border-radius: 24px;
            overflow: hidden;
            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
            position: relative;
            animation: fadeInUp 0.6s ease;
            box-shadow: 0 15px 35px rgba(0, 0, 0, 0.1);
            width: 100%;
            max-width: 380px;
            margin: 0 auto;
        }

        .player-card:hover {
            transform: translateY(-15px) scale(1.03);
            box-shadow: 0 35px 70px rgba(0, 0, 0, 0.25);
            background: rgba(255, 255, 255, 0.25);
            border-color: rgba(255, 255, 255, 0.4);
        }

        .player-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 4px;
            background: linear-gradient(135deg, #06b6d4, #3b82f6, #8b5cf6);
            border-radius: 24px 24px 0 0;
            opacity: 0;
            transition: opacity 0.3s ease;
        }

        .player-card:hover::before {
            opacity: 1;
        }

        @keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(30px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .player-image-section {
            position: relative;
            height: 240px;
            overflow: hidden;
            border-radius: 20px 20px 0 0;
            background: linear-gradient(135deg, rgba(255, 255, 255, 0.1), rgba(255, 255, 255, 0.05));
        }

        .player-image {
            width: 100%;
            height: 100%;
            object-fit: cover;
            object-position: center;
            transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);
            filter: brightness(1.1) contrast(1.05);
        }

        .player-card:hover .player-image {
            transform: scale(1.15);
            filter: brightness(1.2) contrast(1.1);
        }

        .image-overlay {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: linear-gradient(135deg, rgba(0, 0, 0, 0.4), rgba(59, 130, 246, 0.3));
            display: flex;
            align-items: center;
            justify-content: center;
            opacity: 0;
            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
            backdrop-filter: blur(8px);
            -webkit-backdrop-filter: blur(8px);
        }

        .player-card:hover .image-overlay {
            opacity: 1;
        }

        .quick-view-btn {
            background: rgba(255, 255, 255, 0.95);
            color: #1e40af;
            text-decoration: none;
            padding: 1rem 2rem;
            border-radius: 50px;
            font-weight: 700;
            font-size: 0.95rem;
            display: flex;
            align-items: center;
            gap: 0.75rem;
            transform: translateY(30px) scale(0.9);
            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
            border: 2px solid rgba(255, 255, 255, 0.3);
        }

        .player-card:hover .quick-view-btn {
            transform: translateY(0) scale(1);
        }

        .quick-view-btn:hover {
            background: rgba(255, 255, 255, 1);
            transform: translateY(-2px) scale(1.05);
            box-shadow: 0 15px 40px rgba(0, 0, 0, 0.3);
            color: #1e40af;
            text-decoration: none;
        }

        .captain-badge {
            position: absolute;
            top: 1.5rem;
            right: 1.5rem;
            background: linear-gradient(135deg, #fbbf24, #f59e0b);
            color: white;
            padding: 0.5rem 1rem;
            border-radius: 20px;
            font-size: 0.8rem;
            font-weight: 700;
            display: flex;
            align-items: center;
            gap: 0.5rem;
            box-shadow: 0 8px 25px rgba(251, 191, 36, 0.5);
            animation: bounce 2s infinite;
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
            border: 2px solid rgba(255, 255, 255, 0.3);
            z-index: 10;
        }

        @keyframes bounce {

            0%,
            20%,
            50%,
            80%,
            100% {
                transform: translateY(0);
            }

            40% {
                transform: translateY(-5px);
            }

            60% {
                transform: translateY(-3px);
            }
        }

        .player-details {
            padding: 1.5rem 1.5rem 2rem;
            background: rgba(255, 255, 255, 0.02);
        }

        .player-name {
            font-size: 1.25rem;
            font-weight: 800;
            color: white;
            margin-bottom: 0.75rem;
            text-align: center;
            text-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);
            line-height: 1.3;
        }

        .player-team {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.75rem;
            color: rgba(255, 255, 255, 0.9);
            font-size: 1rem;
            font-weight: 600;
            background: rgba(255, 255, 255, 0.1);
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
            border-radius: 15px;
            padding: 0.75rem 1rem;
            border: 1px solid rgba(255, 255, 255, 0.15);
            margin-bottom: 1.5rem;
            transition: all 0.3s ease;
        }

        .player-team:hover {
            background: rgba(255, 255, 255, 0.2);
            transform: translateY(-2px);
        }

        .player-team i {
            color: #06b6d4;
            font-size: 1.1rem;
        }

        .view-details-btn {
            width: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.75rem;
            padding: 1rem 1.25rem;
            border-radius: 16px;
            text-decoration: none;
            font-weight: 700;
            font-size: 0.95rem;
            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
            position: relative;
            overflow: hidden;
            background: linear-gradient(135deg, #3b82f6, #2563eb);
            color: white;
            box-shadow: 0 8px 25px rgba(59, 130, 246, 0.4);
            border: 2px solid rgba(255, 255, 255, 0.1);
        }

        .view-details-btn::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
            transition: left 0.6s ease;
        }

        .view-details-btn:hover::before {
            left: 100%;
        }

        .view-details-btn:hover {
            transform: translateY(-4px);
            box-shadow: 0 15px 40px rgba(59, 130, 246, 0.6);
            border-color: rgba(255, 255, 255, 0.3);
            color: white;
            text-decoration: none;
        }

        /* Enhanced Pagination */
        .pagination-section {
            margin-top: 4rem;
            display: flex;
            justify-content: center;
        }

        .modern-pagination {
            display: flex;
            gap: 0.5rem;
            background: rgba(255, 255, 255, 0.1);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.2);
            border-radius: 20px;
            padding: 1rem;
            box-shadow: 0 15px 35px rgba(0, 0, 0, 0.1);
        }

        .pagination-btn {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 50px;
            height: 50px;
            border-radius: 12px;
            text-decoration: none;
            font-weight: 600;
            transition: all 0.3s ease;
            background: rgba(255, 255, 255, 0.1);
            color: rgba(255, 255, 255, 0.8);
            border: 1px solid rgba(255, 255, 255, 0.2);
        }

        .pagination-btn:hover {
            background: rgba(255, 255, 255, 0.2);
            color: white;
            transform: translateY(-2px);
            text-decoration: none;
        }

        .pagination-btn.active {
            background: linear-gradient(135deg, #3b82f6, #2563eb);
            color: white;
            border-color: #3b82f6;
            box-shadow: 0 8px 25px rgba(59, 130, 246, 0.4);
        }

        /* No Results Section */
        .no-results-section {
            text-align: center;
            padding: 4rem 2rem;
            background: rgba(255, 255, 255, 0.1);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.2);
            border-radius: 25px;
            margin: 2rem 0;
        }

        .no-results-icon {
            width: 100px;
            height: 100px;
            margin: 0 auto 2rem;
            background: rgba(255, 255, 255, 0.1);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 2.5rem;
            color: rgba(255, 255, 255, 0.6);
        }

        .no-results-title {
            font-size: 2rem;
            font-weight: 700;
            color: white;
            margin-bottom: 1rem;
        }

        .no-results-text {
            font-size: 1.1rem;
            color: rgba(255, 255, 255, 0.8);
            margin-bottom: 2rem;
            max-width: 500px;
            margin-left: auto;
            margin-right: auto;
        }

        /* Responsive Design */
        @media (max-width: 1200px) {
            .players-grid {
                grid-template-columns: repeat(auto-fit, minmax(300px, 350px));
                gap: 1.5rem;
            }
        }

        @media (max-width: 968px) {
            .players-grid {
                grid-template-columns: repeat(auto-fit, minmax(280px, 320px));
                gap: 1.5rem;
            }

            .search-controls {
                grid-template-columns: 1fr;
                gap: 1rem;
            }
        }

        @media (max-width: 768px) {
            .page-title {
                font-size: 2rem;
                flex-direction: column;
                gap: 0.5rem;
            }

            .search-filter-section {
                padding: 1.5rem;
            }

            .players-grid {
                grid-template-columns: 1fr;
                gap: 1.5rem;
                max-width: 400px;
            }

            .player-card {
                max-width: 100%;
            }

            .player-image-section {
                height: 220px;
            }
        }

        @media (max-width: 480px) {
            .page-title {
                font-size: 1.8rem;
            }

            .search-filter-section {
                padding: 1rem;
            }

            .players-grid {
                max-width: 350px;
                gap: 1.25rem;
            }

            .player-card {
                border-radius: 20px;
            }

            .player-image-section {
                height: 200px;
                border-radius: 18px 18px 0 0;
            }

            .player-details {
                padding: 1rem 1rem 1.5rem;
            }
        }
    </style>
</head>

<body class="modern-players-page">
    <%- include('partials/header') %>

        <div class="container">
            <!-- Page Header -->
            <div class="page-header">
                <h1 class="page-title">
                    <i class="fas fa-users"></i>
                    Player
                </h1>
                <p class="page-subtitle">
                    Discover and explore our comprehensive collection of world-class football talent
                </p>
            </div>

            <!-- Enhanced Search and Filter Section -->
            <div class="search-filter-section">
                <form action="/" method="GET" id="searchForm">
                    <div class="search-controls">
                        <div class="search-group">
                            <label class="search-label">
                                <i class="fas fa-search"></i> Search Player
                            </label>
                            <input type="text" name="search" class="modern-search-input"
                                placeholder="Search by player name, position, or skill..."
                                value="<%= typeof search !== 'undefined' ? search : '' %>">
                            <i class="fas fa-search search-icon"></i>
                        </div>

                        <div class="filter-group">
                            <label class="search-label">
                                <i class="fas fa-shield-alt"></i> Filter by Team
                            </label>
                            <select class="modern-select" name="team"
                                onchange="document.getElementById('searchForm').submit()">
                                <option value="">All Teams</option>
                                <% teams.forEach(function(team) { %>
                                    <option value="<%= team._id %>" <%=selectedTeam===team._id.toString() ? 'selected'
                                        : '' %>>
                                        <%= team.teamName %>
                                    </option>
                                    <% }); %>
                            </select>
                            <i class="fas fa-chevron-down select-arrow"></i>
                        </div>

                        <button type="submit" class="search-btn">
                            <i class="fas fa-search"></i>
                            <span>Search</span>
                        </button>
                    </div>
                </form>
            </div>

            <!-- Enhanced Players Grid -->
            <div class="players-container">
                <% if (players && players.length> 0) { %>
                    <div class="players-grid">
                        <% players.forEach(function(player) { %>
                            <div class="player-card">
                                <div class="player-image-section">
                                    <img src="<%= player.image %>" alt="<%= player.playerName %>" class="player-image"
                                        onerror="this.src='/images/default-player.jpg'">

                                    <div class="image-overlay">
                                        <a href="/players/<%= player._id %>" class="quick-view-btn">
                                            <i class="fas fa-eye"></i>
                                            <span>View Profile</span>
                                        </a>
                                    </div>

                                    <% if(player.isCaptain) { %>
                                        <div class="captain-badge">
                                            <i class="fas fa-crown"></i>
                                            <span>Captain</span>
                                        </div>
                                        <% } %>
                                </div>

                                <div class="player-details">
                                    <h3 class="player-name">
                                        <%= player.playerName %>
                                    </h3>

                                    <div class="player-team">
                                        <i class="fas fa-shield-alt"></i>
                                        <span>
                                            <%= player.team.teamName %>
                                        </span>
                                    </div>

                                    <a href="/players/<%= player._id %>" class="view-details-btn">
                                        <i class="fas fa-info-circle"></i>
                                        <span>View Full Details</span>
                                    </a>
                                </div>
                            </div>
                            <% }); %>
                    </div>
                    <% } else { %>
                        <div class="no-results-section">
                            <div class="no-results-icon">
                                <i class="fas fa-search"></i>
                            </div>
                            <h3 class="no-results-title">No Players Found</h3>
                            <p class="no-results-text">
                                We couldn't find any players matching your search criteria.
                                Try adjusting your search terms or browse all available players.
                            </p>
                            <a href="/" class="view-details-btn"
                                style="display: inline-flex; width: auto; margin-top: 1rem;">
                                <i class="fas fa-refresh"></i>
                                <span>Reset Search</span>
                            </a>
                        </div>
                        <% } %>
            </div>

            <!-- Enhanced Pagination -->
            <% if (typeof totalPages !=='undefined' && totalPages> 1) { %>
                <div class="pagination-section">
                    <div class="modern-pagination">
                        <% for(let i=1; i <=totalPages; i++) { %>
                            <a class="pagination-btn <%= currentPage == i ? 'active' : '' %>"
                                href="?page=<%= i %><%= search ? '&search=' + search : '' %><%= selectedTeam ? '&team=' + selectedTeam : '' %>">
                                <%= i %>
                            </a>
                            <% } %>
                    </div>
                </div>
                <% } %>
        </div>

        <%- include('partials/footer') %>

            <script>
                // Enhanced search functionality
                document.addEventListener('DOMContentLoaded', function () {
                    // Animate cards on scroll
                    const observerOptions = {
                        threshold: 0.1,
                        rootMargin: '0px 0px -50px 0px'
                    };

                    const observer = new IntersectionObserver((entries) => {
                        entries.forEach(entry => {
                            if (entry.isIntersecting) {
                                entry.target.style.animationDelay = Math.random() * 0.3 + 's';
                                entry.target.classList.add('animate-in');
                            }
                        });
                    }, observerOptions);

                    document.querySelectorAll('.player-card').forEach(card => {
                        observer.observe(card);
                    });

                    // Enhanced search with debouncing
                    const searchInput = document.querySelector('.modern-search-input');
                    let searchTimeout;

                    searchInput.addEventListener('input', function () {
                        clearTimeout(searchTimeout);
                        searchTimeout = setTimeout(() => {
                            // You can add live search functionality here if needed
                        }, 300);
                    });

                    // Smooth transitions for form submission
                    document.getElementById('searchForm').addEventListener('submit', function (e) {
                        const playersGrid = document.querySelector('.players-grid');
                        if (playersGrid) {
                            playersGrid.style.opacity = '0.5';
                            playersGrid.style.transform = 'scale(0.98)';
                        }
                    });
                });

                // Smooth scrolling for pagination
                document.querySelectorAll('.pagination-btn').forEach(btn => {
                    btn.addEventListener('click', function (e) {
                        const playersGrid = document.querySelector('.players-grid');
                        if (playersGrid) {
                            playersGrid.style.opacity = '0.5';
                            playersGrid.style.transform = 'scale(0.98)';
                        }
                    });
                });
            </script>
</body>

</html>