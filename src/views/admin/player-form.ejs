<%- include('../partials/header') %>

    <div class="container mt-4">
        <div class="row justify-content-center">
            <div class="col-md-8">
                <div class="card">
                    <div class="card-header">
                        <h3>
                            <%= player ? 'Edit Player' : 'Add New Player' %>
                        </h3>
                    </div>
                    <div class="card-body">
                        <% if (typeof message !=='undefined' ) { %>
                            <div class="alert alert-<%= message.type %>">
                                <%= message.text %>
                            </div>
                            <% } %>

                                <form action="<%= player ? `/admin/players/${player._id}` : '/admin/players' %>"
                                    method="POST">
                                    <% if (player) { %>
                                        <input type="hidden" name="_method" value="PUT">
                                        <% } %>

                                            <div class="mb-3">
                                                <label for="playerName" class="form-label">Player Name</label>
                                                <input type="text" class="form-control" id="playerName"
                                                    name="playerName" value="<%= player ? player.playerName : '' %>"
                                                    required>
                                            </div>

                                            <div class="mb-3">
                                                <label for="team" class="form-label">Team</label>
                                                <select class="form-select" id="team" name="team" required>
                                                    <option value="">Select Team</option>
                                                    <% teams.forEach(function(team) { %>
                                                        <option value="<%= team._id %>" <%=player &&
                                                            player.team.equals(team._id) ? 'selected' : '' %>>
                                                            <%= team.teamName %>
                                                        </option>
                                                        <% }); %>
                                                </select>
                                            </div>

                                            <div class="mb-3">
                                                <label for="cost" class="form-label">Cost</label>
                                                <input type="number" class="form-control" id="cost" name="cost"
                                                    value="<%= player ? player.cost : '' %>" required>
                                            </div>

                                            <div class="mb-3">
                                                <label for="image" class="form-label">Player Image URL</label>
                                                <% if (player && player.image) { %>
                                                    <div class="mb-2">
                                                        <img src="<%= player.image %>" alt="Current Image"
                                                            style="max-width: 200px;">
                                                    </div>
                                                    <% } %>
                                                        <input type="url" class="form-control" id="image" name="image"
                                                            value="<%= player ? player.image : '' %>"
                                                            placeholder="Enter image URL" <%=player ? '' : 'required'
                                                            %>>
                                                        <small class="form-text text-muted">Enter a valid image URL
                                                            (e.g., https://example.com/image.jpg)</small>
                                            </div>

                                            <div class="mb-3">
                                                <label for="information" class="form-label">Information</label>
                                                <textarea class="form-control" id="information" name="information"
                                                    rows="4" required><%= player ? player.infomation : '' %></textarea>
                                            </div>

                                            <div class="mb-3 form-check">
                                                <input type="checkbox" class="form-check-input" id="isCaptain"
                                                    name="isCaptain" <%=player && player.isCaptain ? 'checked' : '' %>>
                                                <label class="form-check-label" for="isCaptain">Team Captain</label>
                                            </div>

                                            <div class="d-flex justify-content-between">
                                                <a href="/admin/dashboard" class="btn btn-secondary">Back to
                                                    Dashboard</a>
                                                <button type="submit" class="btn btn-primary">
                                                    <%= player ? 'Update Player' : 'Add Player' %>
                                                </button>
                                            </div>
                                </form>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <%- include('../partials/footer') %>