<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login - Football Manager</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
</head>

<body>
    <div class="auth-container">
        <div class="auth-card scale-in">
            <div class="auth-header">
                <h1 class="auth-title">
                    <i class="fas fa-sign-in-alt"></i>
                    Welcome Back
                </h1>
                <p class="auth-subtitle">Sign in to your Football Manager account</p>
            </div>

            <%- include('partials/messages') %>

                <form action="/login" method="POST" class="auth-form">
                    <div class="form-group">
                        <label for="membername" class="form-label">
                            <i class="fas fa-user"></i>
                            Username
                        </label>
                        <input type="text" id="membername" name="membername" class="form-control"
                            placeholder="Enter your username" required autocomplete="username">
                    </div>

                    <div class="form-group">
                        <label for="password" class="form-label">
                            <i class="fas fa-lock"></i>
                            Password
                        </label>
                        <div class="password-input-container">
                            <input type="password" id="password" name="password" class="form-control"
                                placeholder="Enter your password" required autocomplete="current-password">
                            <button type="button" class="password-toggle" onclick="togglePassword()">
                                <i class="fas fa-eye" id="passwordToggleIcon"></i>
                            </button>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-primary btn-block auth-submit">
                        <i class="fas fa-sign-in-alt"></i>
                        Sign In
                        <div class="loading" style="display: none;"></div>
                    </button>
                </form>

                <div class="auth-divider">
                    <span>or</span>
                </div>

                <div class="auth-links">
                    <p>Don't have an account?</p>
                    <a href="/register" class="btn btn-secondary">
                        <i class="fas fa-user-plus"></i>
                        Create Account
                    </a>
                </div>

                <div class="auth-footer">
                    <a href="/" class="back-home">
                        <i class="fas fa-arrow-left"></i>
                        Back to Home
                    </a>
                </div>
        </div>

        <!-- Background Animation -->
        <div class="auth-bg-animation">
            <div class="floating-shape shape-1"></div>
            <div class="floating-shape shape-2"></div>
            <div class="floating-shape shape-3"></div>
            <div class="floating-shape shape-4"></div>
        </div>
    </div>

    <script>
        // Password toggle functionality
        function togglePassword() {
            const passwordInput = document.getElementById('password');
            const toggleIcon = document.getElementById('passwordToggleIcon');

            if (passwordInput.type === 'password') {
                passwordInput.type = 'text';
                toggleIcon.classList.remove('fa-eye');
                toggleIcon.classList.add('fa-eye-slash');
            } else {
                passwordInput.type = 'password';
                toggleIcon.classList.remove('fa-eye-slash');
                toggleIcon.classList.add('fa-eye');
            }
        }

        // Form submission with loading state
        document.querySelector('.auth-form').addEventListener('submit', function (e) {
            const submitBtn = document.querySelector('.auth-submit');
            const loadingElement = submitBtn.querySelector('.loading');
            const btnText = submitBtn.querySelector('i, span');

            // Show loading state
            loadingElement.style.display = 'inline-block';
            submitBtn.disabled = true;
            submitBtn.style.opacity = '0.8';

            // Reset if there's an error (for demo purposes)
            setTimeout(() => {
                if (document.querySelector('.alert-danger')) {
                    loadingElement.style.display = 'none';
                    submitBtn.disabled = false;
                    submitBtn.style.opacity = '1';
                }
            }, 2000);
        });

        // Add input focus effects
        document.querySelectorAll('.form-control').forEach(input => {
            input.addEventListener('focus', function () {
                this.parentElement.classList.add('focused');
            });

            input.addEventListener('blur', function () {
                if (!this.value) {
                    this.parentElement.classList.remove('focused');
                }
            });

            // Check for pre-filled values
            if (input.value) {
                input.parentElement.classList.add('focused');
            }
        });

        // Enhanced animations
        document.addEventListener('DOMContentLoaded', function () {
            // Animate form elements
            const elements = document.querySelectorAll('.form-group, .auth-submit, .auth-links');
            elements.forEach((element, index) => {
                setTimeout(() => {
                    element.classList.add('fade-in-up');
                }, index * 100);
            });
        });
    </script>

    <style>
        /* Auth Container Styles */
        .auth-container {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 50%, #f093fb 100%);
            position: relative;
            overflow: hidden;
        }

        .auth-card {
            max-width: 480px;
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.3);
        }

        .auth-header {
            text-align: center;
            margin-bottom: 2rem;
        }

        .auth-title {
            font-size: 2.5rem;
            font-weight: 800;
            background: var(--primary-gradient);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            margin-bottom: 0.5rem;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.75rem;
        }

        .auth-subtitle {
            color: var(--text-secondary);
            font-size: 1.1rem;
            font-weight: 500;
        }

        /* Enhanced Form Styles */
        .auth-form {
            margin-bottom: 2rem;
        }

        .form-group {
            position: relative;
            margin-bottom: 2rem;
        }

        .form-group.focused .form-label {
            color: #667eea;
            transform: translateY(-2px);
        }

        .form-group.focused .form-control {
            border-color: #667eea;
            box-shadow: 0 0 0 4px rgba(102, 126, 234, 0.1);
            transform: translateY(-2px);
        }

        .form-label {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            margin-bottom: 0.75rem;
            font-weight: 600;
            color: var(--text-primary);
            transition: all 0.3s ease;
        }

        .form-label i {
            width: 20px;
            text-align: center;
            color: #667eea;
        }

        .password-input-container {
            position: relative;
        }

        .password-toggle {
            position: absolute;
            right: 1rem;
            top: 50%;
            transform: translateY(-50%);
            background: none;
            border: none;
            color: var(--text-secondary);
            cursor: pointer;
            padding: 0.5rem;
            border-radius: var(--border-radius);
            transition: all 0.2s ease;
        }

        .password-toggle:hover {
            color: #667eea;
            background: rgba(102, 126, 234, 0.1);
        }

        .auth-submit {
            position: relative;
            overflow: hidden;
            font-size: 1.1rem;
            padding: 1rem 2rem;
            margin-bottom: 1rem;
        }

        .auth-submit .loading {
            margin-left: 0.75rem;
        }

        /* Auth Divider */
        .auth-divider {
            text-align: center;
            margin: 2rem 0;
            position: relative;
        }

        .auth-divider::before {
            content: '';
            position: absolute;
            top: 50%;
            left: 0;
            right: 0;
            height: 1px;
            background: rgba(102, 126, 234, 0.2);
        }

        .auth-divider span {
            background: rgba(255, 255, 255, 0.95);
            padding: 0 1rem;
            color: var(--text-secondary);
            font-weight: 500;
            position: relative;
            z-index: 1;
        }

        /* Auth Links */
        .auth-links {
            text-align: center;
            margin-bottom: 2rem;
        }

        .auth-links p {
            color: var(--text-secondary);
            margin-bottom: 1rem;
            font-weight: 500;
        }

        .auth-links .btn {
            font-size: 1rem;
            padding: 0.875rem 2rem;
        }

        /* Auth Footer */
        .auth-footer {
            text-align: center;
            padding-top: 1.5rem;
            border-top: 1px solid rgba(102, 126, 234, 0.1);
        }

        .back-home {
            color: var(--text-secondary);
            text-decoration: none;
            font-weight: 500;
            transition: all 0.3s ease;
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
        }

        .back-home:hover {
            color: #667eea;
            transform: translateX(-2px);
        }

        /* Background Animation */
        .auth-bg-animation {
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            pointer-events: none;
            z-index: 0;
        }

        .floating-shape {
            position: absolute;
            background: rgba(255, 255, 255, 0.1);
            border-radius: 50%;
            animation: float 6s ease-in-out infinite;
        }

        .shape-1 {
            width: 80px;
            height: 80px;
            top: 10%;
            left: 10%;
            animation-delay: 0s;
        }

        .shape-2 {
            width: 120px;
            height: 120px;
            top: 20%;
            right: 15%;
            animation-delay: 2s;
        }

        .shape-3 {
            width: 60px;
            height: 60px;
            bottom: 20%;
            left: 20%;
            animation-delay: 4s;
        }

        .shape-4 {
            width: 100px;
            height: 100px;
            bottom: 10%;
            right: 10%;
            animation-delay: 1s;
        }

        @keyframes float {

            0%,
            100% {
                transform: translateY(0px) rotate(0deg);
                opacity: 0.5;
            }

            50% {
                transform: translateY(-20px) rotate(180deg);
                opacity: 0.8;
            }
        }

        /* Responsive Design */
        @media (max-width: 768px) {
            .auth-card {
                margin: 1rem;
                padding: 2rem;
            }

            .auth-title {
                font-size: 2rem;
                flex-direction: column;
                gap: 0.5rem;
            }

            .auth-subtitle {
                font-size: 1rem;
            }

            .floating-shape {
                display: none;
            }
        }

        @media (max-width: 480px) {
            .auth-card {
                padding: 1.5rem;
            }

            .auth-title {
                font-size: 1.75rem;
            }

            .form-group {
                margin-bottom: 1.5rem;
            }
        }
    </style>
</body>

</html>