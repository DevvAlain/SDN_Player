<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Football Manager - Home</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap"
        rel="stylesheet">
    <style>
        /* Custom Home Page Styles - Blue/Cyan Theme */
        .modern-home {
            background: linear-gradient(135deg, #0ea5e9 0%, #0284c7 25%, #0369a1 50%, #1e40af 75%, #1e3a8a 100%);
            background-attachment: fixed;
        }

        .modern-hero {
            position: relative;
            min-height: 80vh;
            display: flex;
            align-items: center;
            overflow: hidden;
            padding: 4rem 0;
        }

        .hero-background {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            overflow: hidden;
            z-index: 1;
        }

        .floating-elements {
            position: absolute;
            width: 100%;
            height: 100%;
        }

        .floating-circle,
        .floating-triangle {
            position: absolute;
            background: rgba(255, 255, 255, 0.1);
            border-radius: 50%;
            animation: float 6s ease-in-out infinite;
        }

        .floating-circle:nth-child(1) {
            width: 80px;
            height: 80px;
            top: 20%;
            left: 10%;
            animation-delay: 0s;
            background: linear-gradient(135deg, rgba(6, 182, 212, 0.3), rgba(8, 145, 178, 0.2));
        }

        .floating-circle:nth-child(2) {
            width: 120px;
            height: 120px;
            top: 60%;
            right: 15%;
            animation-delay: 2s;
            background: linear-gradient(135deg, rgba(59, 130, 246, 0.3), rgba(37, 99, 235, 0.2));
        }

        .floating-circle:nth-child(3) {
            width: 60px;
            height: 60px;
            bottom: 20%;
            left: 20%;
            animation-delay: 4s;
            background: linear-gradient(135deg, rgba(16, 185, 129, 0.3), rgba(5, 150, 105, 0.2));
        }

        .floating-triangle {
            border-radius: 20%;
            clip-path: polygon(50% 0%, 0% 100%, 100% 100%);
        }

        .floating-triangle:nth-child(4) {
            width: 100px;
            height: 100px;
            top: 30%;
            right: 20%;
            animation-delay: 1s;
            background: linear-gradient(135deg, rgba(14, 165, 233, 0.2), rgba(2, 132, 199, 0.1));
        }

        .floating-triangle:nth-child(5) {
            width: 70px;
            height: 70px;
            bottom: 40%;
            right: 10%;
            animation-delay: 3s;
            background: linear-gradient(135deg, rgba(30, 64, 175, 0.2), rgba(30, 58, 138, 0.1));
        }

        @keyframes float {

            0%,
            100% {
                transform: translateY(0px) rotate(0deg);
            }

            50% {
                transform: translateY(-20px) rotate(180deg);
            }
        }

        .hero-content {
            position: relative;
            z-index: 2;
            text-align: center;
            max-width: 900px;
            margin: 0 auto;
        }

        .hero-badge {
            display: inline-flex;
            align-items: center;
            gap: 0.75rem;
            background: rgba(255, 255, 255, 0.2);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.3);
            border-radius: 50px;
            padding: 0.75rem 1.5rem;
            margin-bottom: 2rem;
            color: white;
            font-weight: 600;
            font-size: 0.95rem;
            animation: slideInDown 0.8s ease;
        }

        .hero-badge i {
            color: #fbbf24;
            animation: spin 3s linear infinite;
        }

        @keyframes slideInDown {
            from {
                opacity: 0;
                transform: translateY(-30px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .hero-title {
            font-size: 3.5rem;
            font-weight: 900;
            line-height: 1.1;
            margin-bottom: 1.5rem;
            color: white;
            animation: slideInUp 0.8s ease 0.2s both;
        }

        .gradient-text {
            background: linear-gradient(135deg, #06b6d4, #3b82f6, #8b5cf6);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            animation: gradientShift 3s ease-in-out infinite;
        }

        @keyframes gradientShift {

            0%,
            100% {
                filter: hue-rotate(0deg);
            }

            50% {
                filter: hue-rotate(45deg);
            }
        }

        @keyframes slideInUp {
            from {
                opacity: 0;
                transform: translateY(30px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .hero-subtitle {
            font-size: 1.2rem;
            line-height: 1.7;
            color: rgba(255, 255, 255, 0.9);
            margin-bottom: 3rem;
            max-width: 600px;
            margin-left: auto;
            margin-right: auto;
            animation: slideInUp 0.8s ease 0.4s both;
        }

        .hero-stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 1.5rem;
            margin-bottom: 3rem;
            animation: slideInUp 0.8s ease 0.6s both;
        }

        .stat-card {
            background: rgba(255, 255, 255, 0.15);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.2);
            border-radius: 20px;
            padding: 2rem 1.5rem;
            display: flex;
            align-items: center;
            gap: 1rem;
            transition: all 0.3s ease;
            animation: scaleIn 0.6s ease;
        }

        .stat-card:hover {
            transform: translateY(-5px);
            background: rgba(255, 255, 255, 0.25);
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.2);
        }

        .stat-icon {
            width: 60px;
            height: 60px;
            border-radius: 15px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: linear-gradient(135deg, #06b6d4, #3b82f6);
            color: white;
            font-size: 1.5rem;
        }

        .stat-content {
            flex: 1;
        }

        .stat-number {
            font-size: 2rem;
            font-weight: 800;
            color: white;
            line-height: 1;
            margin-bottom: 0.25rem;
        }

        .stat-label {
            font-size: 0.9rem;
            color: rgba(255, 255, 255, 0.8);
            font-weight: 500;
        }

        .hero-actions {
            display: flex;
            gap: 1rem;
            justify-content: center;
            flex-wrap: wrap;
            animation: slideInUp 0.8s ease 0.8s both;
        }

        .btn-hero {
            display: inline-flex;
            align-items: center;
            gap: 0.75rem;
            padding: 1rem 2rem;
            border-radius: 15px;
            text-decoration: none;
            font-weight: 600;
            font-size: 1rem;
            transition: all 0.3s ease;
            border: 2px solid transparent;
            position: relative;
            overflow: hidden;
        }

        .btn-hero::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
            transition: left 0.6s ease;
        }

        .btn-hero:hover::before {
            left: 100%;
        }

        .btn-hero.btn-primary {
            background: linear-gradient(135deg, #3b82f6, #2563eb);
            color: white;
            box-shadow: 0 10px 30px rgba(59, 130, 246, 0.4);
        }

        .btn-hero.btn-primary:hover {
            transform: translateY(-3px);
            box-shadow: 0 15px 40px rgba(59, 130, 246, 0.6);
        }

        .btn-hero.btn-secondary {
            background: rgba(255, 255, 255, 0.2);
            color: white;
            border-color: rgba(255, 255, 255, 0.3);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
        }

        .btn-hero.btn-secondary:hover {
            background: rgba(255, 255, 255, 0.3);
            transform: translateY(-3px);
            box-shadow: 0 15px 30px rgba(0, 0, 0, 0.2);
        }

        /* Search Control Center */
        .search-control-center {
            padding: 4rem 0;
            background: rgba(255, 255, 255, 0.05);
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
            border-top: 1px solid rgba(255, 255, 255, 0.1);
        }

        .control-panel {
            background: rgba(255, 255, 255, 0.1);
            backdrop-filter: blur(30px);
            -webkit-backdrop-filter: blur(30px);
            border: 1px solid rgba(255, 255, 255, 0.2);
            border-radius: 25px;
            padding: 2.5rem;
            box-shadow: 0 25px 50px rgba(0, 0, 0, 0.2);
        }

        .panel-header {
            text-align: center;
            margin-bottom: 2.5rem;
        }

        .panel-header h2 {
            font-size: 2.2rem;
            font-weight: 800;
            color: white;
            margin-bottom: 0.75rem;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 1rem;
        }

        .panel-header i {
            background: linear-gradient(135deg, #06b6d4, #3b82f6);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .panel-header p {
            color: rgba(255, 255, 255, 0.8);
            font-size: 1.1rem;
        }

        .search-controls {
            display: grid;
            grid-template-columns: 1fr auto auto;
            gap: 1.5rem;
            align-items: center;
        }

        .search-field {
            position: relative;
        }

        .modern-input {
            width: 100%;
            padding: 1rem 1rem 1rem 3rem;
            border: 2px solid rgba(255, 255, 255, 0.2);
            border-radius: 15px;
            background: rgba(255, 255, 255, 0.9);
            font-size: 1.05rem;
            font-weight: 500;
            color: var(--text-primary);
            transition: all 0.3s ease;
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
        }

        .modern-input:focus {
            outline: none;
            border-color: #3b82f6;
            background: rgba(255, 255, 255, 1);
            box-shadow: 0 0 0 4px rgba(59, 130, 246, 0.1);
            transform: translateY(-2px);
        }

        .search-icon {
            position: absolute;
            left: 1rem;
            top: 50%;
            transform: translateY(-50%);
            color: #6b7280;
            font-size: 1.1rem;
        }

        .filter-group {
            position: relative;
        }

        .modern-select {
            padding: 1rem 3rem 1rem 1rem;
            border: 2px solid rgba(255, 255, 255, 0.2);
            border-radius: 15px;
            background: rgba(255, 255, 255, 0.9);
            font-size: 1rem;
            font-weight: 500;
            color: var(--text-primary);
            cursor: pointer;
            transition: all 0.3s ease;
            appearance: none;
            min-width: 180px;
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
        }

        .modern-select:focus {
            outline: none;
            border-color: #3b82f6;
            background: rgba(255, 255, 255, 1);
            box-shadow: 0 0 0 4px rgba(59, 130, 246, 0.1);
        }

        .select-arrow {
            position: absolute;
            right: 1rem;
            top: 50%;
            transform: translateY(-50%);
            color: #6b7280;
            pointer-events: none;
        }

        .view-controls {
            display: flex;
            gap: 0.5rem;
        }

        .view-toggle {
            width: 50px;
            height: 50px;
            border: 2px solid rgba(255, 255, 255, 0.3);
            border-radius: 12px;
            background: rgba(255, 255, 255, 0.1);
            color: rgba(255, 255, 255, 0.8);
            cursor: pointer;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.1rem;
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
        }

        .view-toggle:hover {
            background: rgba(255, 255, 255, 0.2);
            color: white;
            transform: translateY(-2px);
        }

        .view-toggle.active {
            background: linear-gradient(135deg, #3b82f6, #2563eb);
            border-color: #3b82f6;
            color: white;
            box-shadow: 0 8px 25px rgba(59, 130, 246, 0.4);
        }

        /* Players Showcase */
        .players-showcase {
            padding: 4rem 0;
            background: rgba(255, 255, 255, 0.02);
        }

        .showcase-header {
            margin-bottom: 3rem;
        }

        .header-content {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 1.5rem;
        }

        .showcase-title {
            font-size: 2rem;
            font-weight: 800;
            color: white;
            display: flex;
            align-items: center;
            gap: 1rem;
        }

        .showcase-title i {
            background: linear-gradient(135deg, #06b6d4, #3b82f6);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .result-counter {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            background: rgba(255, 255, 255, 0.1);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.2);
            border-radius: 20px;
            padding: 0.75rem 1.5rem;
        }

        .counter-number {
            font-size: 1.5rem;
            font-weight: 800;
            color: white;
        }

        .counter-text {
            color: rgba(255, 255, 255, 0.8);
            font-weight: 500;
        }

        /* Enhanced Player Cards */
        .players-showcase-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(320px, 380px));
            gap: 2rem;
            padding: 1rem 0;
            justify-content: center;
            align-items: start;
            max-width: 1400px;
            margin: 0 auto;
        }

        .elite-player-card {
            background: rgba(255, 255, 255, 0.15);
            backdrop-filter: blur(25px);
            -webkit-backdrop-filter: blur(25px);
            border: 1px solid rgba(255, 255, 255, 0.2);
            border-radius: 24px;
            overflow: hidden;
            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
            position: relative;
            animation: fadeInUp 0.6s ease;
            box-shadow: 0 15px 35px rgba(0, 0, 0, 0.1);
            width: 100%;
            max-width: 380px;
            margin: 0 auto;
        }

        .elite-player-card:hover {
            transform: translateY(-15px) scale(1.03);
            box-shadow: 0 35px 70px rgba(0, 0, 0, 0.25);
            background: rgba(255, 255, 255, 0.25);
            border-color: rgba(255, 255, 255, 0.4);
        }

        .elite-player-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 4px;
            background: linear-gradient(135deg, #06b6d4, #3b82f6, #8b5cf6);
            border-radius: 28px 28px 0 0;
            opacity: 0;
            transition: opacity 0.3s ease;
        }

        .elite-player-card:hover::before {
            opacity: 1;
        }

        @keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(30px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .player-image-section {
            position: relative;
            height: 240px;
            overflow: hidden;
            border-radius: 20px 20px 0 0;
            background: linear-gradient(135deg, rgba(255, 255, 255, 0.1), rgba(255, 255, 255, 0.05));
        }

        .image-container {
            position: relative;
            width: 100%;
            height: 100%;
            border-radius: 20px 20px 0 0;
            overflow: hidden;
        }

        .player-image {
            width: 100%;
            height: 100%;
            object-fit: cover;
            object-position: center;
            transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);
            filter: brightness(1.1) contrast(1.05);
        }

        .elite-player-card:hover .player-image {
            transform: scale(1.15);
            filter: brightness(1.2) contrast(1.1);
        }

        .image-overlay {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: linear-gradient(135deg, rgba(0, 0, 0, 0.4), rgba(59, 130, 246, 0.3));
            display: flex;
            align-items: center;
            justify-content: center;
            opacity: 0;
            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
            backdrop-filter: blur(8px);
            -webkit-backdrop-filter: blur(8px);
        }

        .elite-player-card:hover .image-overlay {
            opacity: 1;
        }

        .quick-view-btn {
            background: rgba(255, 255, 255, 0.95);
            color: #1e40af;
            text-decoration: none;
            padding: 1rem 2rem;
            border-radius: 50px;
            font-weight: 700;
            font-size: 0.95rem;
            display: flex;
            align-items: center;
            gap: 0.75rem;
            transform: translateY(30px) scale(0.9);
            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
            border: 2px solid rgba(255, 255, 255, 0.3);
        }

        .elite-player-card:hover .quick-view-btn {
            transform: translateY(0) scale(1);
        }

        .quick-view-btn:hover {
            background: rgba(255, 255, 255, 1);
            transform: translateY(-2px) scale(1.05);
            box-shadow: 0 15px 40px rgba(0, 0, 0, 0.3);
        }

        .captain-crown {
            position: absolute;
            top: 1.5rem;
            right: 1.5rem;
            background: linear-gradient(135deg, #fbbf24, #f59e0b);
            color: white;
            padding: 0.75rem 1.25rem;
            border-radius: 25px;
            font-size: 0.85rem;
            font-weight: 700;
            display: flex;
            align-items: center;
            gap: 0.5rem;
            box-shadow: 0 10px 30px rgba(251, 191, 36, 0.5);
            animation: bounce 2s infinite;
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
            border: 2px solid rgba(255, 255, 255, 0.3);
            z-index: 10;
        }

        @keyframes bounce {

            0%,
            20%,
            50%,
            80%,
            100% {
                transform: translateY(0);
            }

            40% {
                transform: translateY(-5px);
            }

            60% {
                transform: translateY(-3px);
            }
        }

        .player-details {
            padding: 1.5rem 1.5rem 2rem;
            background: rgba(255, 255, 255, 0.02);
        }

        .player-header {
            margin-bottom: 1rem;
            text-align: center;
        }

        .player-name {
            font-size: 1.25rem;
            font-weight: 800;
            color: white;
            margin-bottom: 0.5rem;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.5rem;
            text-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);
            line-height: 1.3;
        }

        .captain-icon {
            color: #fbbf24;
            font-size: 1rem;
        }

        .player-rating-badge {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 1rem;
            margin-bottom: 1.5rem;
            background: rgba(255, 255, 255, 0.1);
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
            border-radius: 20px;
            padding: 0.75rem 1.25rem;
            border: 1px solid rgba(255, 255, 255, 0.15);
        }

        .rating-stars {
            display: flex;
            gap: 0.4rem;
        }

        .rating-stars i {
            color: rgba(255, 255, 255, 0.4);
            font-size: 1rem;
            transition: all 0.3s ease;
        }

        .rating-stars i.active {
            color: #fbbf24;
            text-shadow: 0 0 10px rgba(251, 191, 36, 0.5);
        }

        .rating-count {
            color: rgba(255, 255, 255, 0.8);
            font-size: 0.9rem;
            font-weight: 600;
        }

        .player-meta {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 0.75rem;
            margin-bottom: 1.5rem;
        }

        .meta-item {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.75rem;
            color: rgba(255, 255, 255, 0.95);
            font-size: 0.9rem;
            font-weight: 600;
            background: rgba(255, 255, 255, 0.08);
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
            border-radius: 12px;
            padding: 0.75rem 1rem;
            border: 1px solid rgba(255, 255, 255, 0.12);
            transition: all 0.3s ease;
        }

        .meta-item:hover {
            background: rgba(255, 255, 255, 0.15);
            transform: translateY(-2px);
        }

        .meta-item i {
            width: 20px;
            text-align: center;
            color: #06b6d4;
            font-size: 1.1rem;
        }

        .player-actions {
            display: flex;
            gap: 1rem;
        }

        .action-btn {
            flex: 1;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.75rem;
            padding: 1rem 1.25rem;
            border-radius: 16px;
            text-decoration: none;
            font-weight: 700;
            font-size: 0.9rem;
            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
            position: relative;
            overflow: hidden;
        }

        .action-btn::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
            transition: left 0.6s ease;
        }

        .action-btn:hover::before {
            left: 100%;
        }

        .action-btn.primary {
            background: linear-gradient(135deg, #3b82f6, #2563eb);
            color: white;
            box-shadow: 0 8px 25px rgba(59, 130, 246, 0.4);
            border: 2px solid rgba(255, 255, 255, 0.1);
        }

        .action-btn.primary:hover {
            transform: translateY(-4px);
            box-shadow: 0 15px 40px rgba(59, 130, 246, 0.6);
            border-color: rgba(255, 255, 255, 0.3);
        }

        .action-btn.secondary {
            background: rgba(255, 255, 255, 0.15);
            color: white;
            border: 2px solid rgba(255, 255, 255, 0.25);
            backdrop-filter: blur(15px);
            -webkit-backdrop-filter: blur(15px);
        }

        .action-btn.secondary:hover {
            background: rgba(255, 255, 255, 0.25);
            border-color: rgba(255, 255, 255, 0.4);
            transform: translateY(-4px);
            box-shadow: 0 15px 35px rgba(0, 0, 0, 0.2);
        }

        /* No Results Section */
        .no-results-section {
            text-align: center;
            padding: 4rem 2rem;
            background: rgba(255, 255, 255, 0.1);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.2);
            border-radius: 25px;
            margin: 2rem 0;
        }

        .no-results-icon {
            width: 100px;
            height: 100px;
            margin: 0 auto 2rem;
            background: rgba(255, 255, 255, 0.1);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 2.5rem;
            color: rgba(255, 255, 255, 0.6);
        }

        .no-results-title {
            font-size: 2rem;
            font-weight: 700;
            color: white;
            margin-bottom: 1rem;
        }

        .no-results-text {
            font-size: 1.1rem;
            color: rgba(255, 255, 255, 0.8);
            margin-bottom: 2rem;
            max-width: 500px;
            margin-left: auto;
            margin-right: auto;
        }

        /* Responsive Design */
        @media (max-width: 1200px) {
            .players-showcase-grid {
                grid-template-columns: repeat(auto-fit, minmax(300px, 350px));
                gap: 1.5rem;
                max-width: 1200px;
            }
        }

        @media (max-width: 968px) {
            .players-showcase-grid {
                grid-template-columns: repeat(auto-fit, minmax(280px, 320px));
                gap: 1.5rem;
                max-width: 700px;
                justify-content: center;
            }
        }

        @media (max-width: 768px) {
            .hero-title {
                font-size: 2.5rem;
            }

            .hero-stats-grid {
                grid-template-columns: 1fr;
                gap: 1rem;
            }

            .search-controls {
                grid-template-columns: 1fr;
                gap: 1rem;
            }

            .header-content {
                flex-direction: column;
                text-align: center;
            }

            .players-showcase-grid {
                grid-template-columns: 1fr;
                gap: 1.5rem;
                padding: 0.5rem;
                max-width: 400px;
            }

            .hero-actions {
                flex-direction: column;
                align-items: center;
            }

            .btn-hero {
                width: 100%;
                max-width: 280px;
            }

            .elite-player-card {
                border-radius: 20px;
                max-width: 100%;
            }

            .player-image-section {
                height: 220px;
            }

            .player-details {
                padding: 1.25rem 1.25rem 1.75rem;
            }

            .player-actions {
                flex-direction: column;
                gap: 0.75rem;
            }

            .action-btn {
                padding: 0.875rem 1rem;
            }
        }

        @media (max-width: 480px) {
            .hero-title {
                font-size: 2rem;
            }

            .panel-header h2 {
                font-size: 1.8rem;
            }

            .control-panel {
                padding: 1.5rem;
            }

            .players-showcase-grid {
                gap: 1.25rem;
                padding: 0.25rem;
                max-width: 350px;
            }

            .elite-player-card {
                border-radius: 18px;
            }

            .player-image-section {
                height: 200px;
                border-radius: 18px 18px 0 0;
            }

            .image-container {
                border-radius: 18px 18px 0 0;
            }

            .player-name {
                font-size: 1.2rem;
            }

            .player-details {
                padding: 1rem 1rem 1.5rem;
            }

            .meta-item {
                padding: 0.75rem 1rem;
                font-size: 0.9rem;
            }

            .action-btn {
                padding: 0.75rem 0.875rem;
                font-size: 0.85rem;
            }
        }
    </style>
</head>

<body class="modern-home">
    <%- include('partials/header') %>

        <!-- Modern Hero Section -->
        <section class="modern-hero">
            <div class="hero-background">
                <div class="floating-elements">
                    <div class="floating-circle"></div>
                    <div class="floating-circle"></div>
                    <div class="floating-circle"></div>
                    <div class="floating-triangle"></div>
                    <div class="floating-triangle"></div>
                </div>
            </div>

            <div class="container">
                <div class="hero-content">
                    <div class="hero-badge">
                        <i class="fas fa-trophy"></i>
                        <span>Premier Football Manager</span>
                    </div>

                    <h1 class="hero-title">
                        Build Your <span class="gradient-text">Dream Team</span>
                        <br>Manage Like a <span class="gradient-text">Champion</span>
                    </h1>

                    <p class="hero-subtitle">
                        Experience the ultimate football management simulation. Scout talented players,
                        build unbeatable formations, and lead your team to glory in the most immersive
                        football experience ever created.
                    </p>

                    <div class="hero-stats-grid">
                        <div class="stat-card">
                            <div class="stat-icon">
                                <i class="fas fa-users"></i>
                            </div>
                            <div class="stat-content">
                                <div class="stat-number" id="totalPlayers">0</div>
                                <div class="stat-label">Elite Players</div>
                            </div>
                        </div>

                        <div class="stat-card">
                            <div class="stat-icon">
                                <i class="fas fa-shield-alt"></i>
                            </div>
                            <div class="stat-content">
                                <div class="stat-number" id="totalTeams">0</div>
                                <div class="stat-label">Championship Teams</div>
                            </div>
                        </div>

                        <div class="stat-card">
                            <div class="stat-icon">
                                <i class="fas fa-star"></i>
                            </div>
                            <div class="stat-content">
                                <div class="stat-number" id="totalComments">0</div>
                                <div class="stat-label">Expert Reviews</div>
                            </div>
                        </div>
                    </div>

                    <div class="hero-actions">
                        <a href="#players" class="btn-hero btn-primary">
                            <i class="fas fa-rocket"></i>
                            <span>Explore Players</span>
                        </a>
                        <a href="/register" class="btn-hero btn-secondary">
                            <i class="fas fa-play"></i>
                            <span>Start Managing</span>
                        </a>
                    </div>
                </div>
            </div>
        </section>

        <!-- Enhanced Search Section -->
        <section class="search-control-center" id="players">
            <div class="container">
                <div class="control-panel">
                    <div class="panel-header">
                        <h2>
                            <i class="fas fa-search"></i>
                            Player Discovery Center
                        </h2>
                        <p>Find and analyze world-class talent</p>
                    </div>

                    <div class="search-controls">
                        <div class="search-field">
                            <input type="text" class="modern-input" id="searchInput"
                                placeholder="Search by player name, position, or skill..."
                                value="<%= searchQuery || '' %>">
                            <i class="fas fa-search search-icon"></i>
                        </div>

                        <div class="filter-group">
                            <select class="modern-select" id="teamFilter">
                                <option value="">All Teams</option>
                                <% teams.forEach(team=> { %>
                                    <option value="<%= team.teamName %>" <%=selectedTeam===team.teamName ? 'selected'
                                        : '' %>>
                                        <%= team.teamName %>
                                    </option>
                                    <% }) %>
                            </select>
                            <i class="fas fa-chevron-down select-arrow"></i>
                        </div>

                        <div class="view-controls">
                            <button class="view-toggle active" data-view="grid" title="Grid View">
                                <i class="fas fa-th-large"></i>
                            </button>
                            <button class="view-toggle" data-view="list" title="List View">
                                <i class="fas fa-list"></i>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Players Showcase -->
        <section class="players-showcase">
            <div class="container">
                <%- include('partials/messages') %>

                    <div class="showcase-header">
                        <div class="header-content">
                            <h2 class="showcase-title">
                                <i class="fas fa-users"></i>
                                Elite Player Roster
                            </h2>
                            <div class="result-counter">
                                <span class="counter-number">
                                    <%= players.length %>
                                </span>
                                <span class="counter-text">Players Available</span>
                            </div>
                        </div>
                    </div>

                    <% if (players && players.length> 0) { %>
                        <div class="players-showcase-grid" id="playersContainer">
                            <% players.forEach(player=> { %>
                                <div class="elite-player-card"
                                    data-team="<%= player.team ? player.team.teamName : '' %>">
                                    <div class="player-image-section">
                                        <div class="image-container">
                                            <img src="<%= player.image %>" alt="<%= player.playerName %>"
                                                class="player-image" onerror="this.src='/images/default-player.jpg'">
                                            <div class="image-overlay">
                                                <a href="/players/<%= player._id %>" class="quick-view-btn">
                                                    <i class="fas fa-eye"></i>
                                                    <span>View Profile</span>
                                                </a>
                                            </div>
                                        </div>

                                        <% if (player.isCaptain) { %>
                                            <div class="captain-crown">
                                                <i class="fas fa-crown"></i>
                                                <span>Captain</span>
                                            </div>
                                            <% } %>
                                    </div>

                                    <div class="player-details">
                                        <div class="player-header">
                                            <h3 class="player-name">
                                                <%= player.playerName %>
                                                    <% if (player.isCaptain) { %>
                                                        <i class="fas fa-crown captain-icon"></i>
                                                        <% } %>
                                            </h3>

                                            <div class="player-rating-badge">
                                                <% let averageRating=0; if (player.comments && player.comments.length>
                                                    0) {
                                                    averageRating = player.comments.reduce((sum, comment) => sum +
                                                    comment.rating, 0) / player.comments.length;
                                                    }
                                                    %>
                                                    <div class="rating-stars">
                                                        <% for (let i=1; i <=3; i++) { %>
                                                            <i
                                                                class="fas fa-star <%= i <= Math.round(averageRating) ? 'active' : '' %>"></i>
                                                            <% } %>
                                                    </div>
                                                    <span class="rating-count">(<%= player.comments ?
                                                            player.comments.length : 0 %>)</span>
                                            </div>
                                        </div>

                                        <div class="player-meta">
                                            <div class="meta-item team-info">
                                                <i class="fas fa-shield-alt"></i>
                                                <span>
                                                    <%= player.team ? player.team.teamName : 'Free Agent' %>
                                                </span>
                                            </div>

                                            <div class="meta-item value-info">
                                                <i class="fas fa-dollar-sign"></i>
                                                <span>$<%= player.cost ? player.cost.toLocaleString() : '0' %></span>
                                            </div>
                                        </div>

                                        <div class="player-actions">
                                            <a href="/players/<%= player._id %>" class="action-btn primary">
                                                <i class="fas fa-info-circle"></i>
                                                <span>Full Profile</span>
                                            </a>
                                            <% if (user) { %>
                                                <a href="/players/<%= player._id %>#comment-form"
                                                    class="action-btn secondary">
                                                    <i class="fas fa-star"></i>
                                                    <span>Rate Player</span>
                                                </a>
                                                <% } %>
                                        </div>
                                    </div>
                                </div>
                                <% }) %>
                        </div>
                        <% } else { %>
                            <div class="no-results-section">
                                <div class="no-results-icon">
                                    <i class="fas fa-search"></i>
                                </div>
                                <h3 class="no-results-title">No Players Found</h3>
                                <p class="no-results-text">
                                    We couldn't find any players matching your criteria.
                                    Try adjusting your search terms or browse all available players.
                                </p>
                                <a href="/" class="btn-hero btn-primary">
                                    <i class="fas fa-refresh"></i>
                                    <span>Reset Search</span>
                                </a>
                            </div>
                            <% } %>
            </div>
        </section>

        <%- include('partials/footer') %>

            <script>
                // Modern Search Functionality
                class PlayerSearch {
                    constructor() {
                        this.searchInput = document.getElementById('searchInput');
                        this.teamFilter = document.getElementById('teamFilter');
                        this.playersContainer = document.getElementById('playersContainer');
                        this.searchTimeout = null;
                        this.init();
                    }

                    init() {
                        this.bindEvents();
                        this.animateCounters();
                        this.initScrollAnimations();
                        this.initViewToggles();
                    }

                    bindEvents() {
                        this.searchInput.addEventListener('input', () => {
                            clearTimeout(this.searchTimeout);
                            this.searchTimeout = setTimeout(() => this.performSearch(), 300);
                        });

                        this.teamFilter.addEventListener('change', () => this.performSearch());
                    }

                    performSearch() {
                        const searchTerm = this.searchInput.value.trim();
                        const selectedTeam = this.teamFilter.value;

                        const url = new URL(window.location.href);
                        url.searchParams.delete('search');
                        url.searchParams.delete('team');

                        if (searchTerm) url.searchParams.set('search', searchTerm);
                        if (selectedTeam) url.searchParams.set('team', selectedTeam);

                        // Add loading effect
                        if (this.playersContainer) {
                            this.playersContainer.style.opacity = '0.5';
                            this.playersContainer.style.transform = 'scale(0.98)';
                        }

                        setTimeout(() => {
                            window.location.href = url.toString();
                        }, 200);
                    }

                    animateCounters() {
                        const animateCounter = (element, target) => {
                            let current = 0;
                            const increment = target / 60;
                            const timer = setInterval(() => {
                                current += increment;
                                if (current >= target) {
                                    element.textContent = target;
                                    clearInterval(timer);
                                } else {
                                    element.textContent = Math.floor(current);
                                }
                            }, 25);
                        };

                        setTimeout(() => {
                            const totalPlayersCount = parseInt(document.querySelector('.counter-number')?.textContent || 0);
                            const totalTeamsCount = document.querySelectorAll('option[value]').length - 1;

                            let totalCommentsCount = 0;
                            document.querySelectorAll('.rating-count').forEach(ratingCount => {
                                const match = ratingCount.textContent.match(/\((\d+)\)/);
                                if (match) totalCommentsCount += parseInt(match[1]);
                            });

                            animateCounter(document.getElementById('totalPlayers'), totalPlayersCount);
                            animateCounter(document.getElementById('totalTeams'), totalTeamsCount);
                            animateCounter(document.getElementById('totalComments'), totalCommentsCount);
                        }, 1000);
                    }

                    initScrollAnimations() {
                        const observerOptions = {
                            threshold: 0.1,
                            rootMargin: '0px 0px -50px 0px'
                        };

                        const observer = new IntersectionObserver((entries) => {
                            entries.forEach(entry => {
                                if (entry.isIntersecting) {
                                    entry.target.classList.add('animate-in');
                                }
                            });
                        }, observerOptions);

                        document.querySelectorAll('.elite-player-card, .stat-card, .control-panel').forEach(el => {
                            observer.observe(el);
                        });
                    }

                    initViewToggles() {
                        const viewButtons = document.querySelectorAll('.view-toggle');
                        viewButtons.forEach(btn => {
                            btn.addEventListener('click', () => {
                                viewButtons.forEach(b => b.classList.remove('active'));
                                btn.classList.add('active');

                                const view = btn.dataset.view;
                                const playersGrid = document.querySelector('.players-showcase-grid');

                                if (playersGrid) {
                                    if (view === 'list') {
                                        playersGrid.classList.add('list-view');
                                    } else {
                                        playersGrid.classList.remove('list-view');
                                    }
                                }
                            });
                        });
                    }
                }

                // Initialize when DOM is loaded
                document.addEventListener('DOMContentLoaded', () => {
                    new PlayerSearch();
                });

                // Smooth scrolling for hero actions
                document.querySelectorAll('a[href^="#"]').forEach(anchor => {
                    anchor.addEventListener('click', function (e) {
                        e.preventDefault();
                        const target = document.querySelector(this.getAttribute('href'));
                        if (target) {
                            target.scrollIntoView({
                                behavior: 'smooth',
                                block: 'start'
                            });
                        }
                    });
                });
            </script>
</body>

</html>