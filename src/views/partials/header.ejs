<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= typeof title !=='undefined' ? title : 'Football Management' %>
    </title>
    <link rel="stylesheet" href="/css/style.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
</head>

<body>
    <header class="header">
        <div class="container">
            <nav class="navbar">
                <div class="logo">
                    <i class="fas fa-futbol"></i> Football Manager
                </div>
                <ul class="nav-menu">
                    <li><a href="/" class="nav-link">Trang chủ</a></li>
                    <% if (typeof user !=='undefined' && user) { %>
                        <% if (user.isAdmin) { %>
                            <li><a href="/admin/dashboard" class="nav-link">Dashboard</a></li>
                            <li><a href="/admin/accounts" class="nav-link">Quản lý tài khoản</a></li>
                            <% } %>
                                <li><a href="/profile" class="nav-link">
                                        <i class="fas fa-user"></i> Hồ sơ
                                    </a></li>
                                <li>
                                    <form method="POST" action="/logout" style="display: inline;">
                                        <button type="submit" class="btn btn-secondary">
                                            <i class="fas fa-sign-out-alt"></i> Đăng xuất
                                        </button>
                                    </form>
                                </li>
                                <% } else { %>
                                    <li><a href="/login" class="btn btn-primary">
                                            <i class="fas fa-sign-in-alt"></i> Đăng nhập
                                        </a></li>
                                    <li><a href="/register" class="btn btn-secondary">
                                            <i class="fas fa-user-plus"></i> Đăng ký
                                        </a></li>
                                    <% } %>
                </ul>
            </nav>
        </div>
    </header>

    <% if (typeof message !=='undefined' && message) { %>
        <div class="container">
            <div class="alert alert-<%= message.type %>">
                <i class="fas <%= message.type === 'success' ? 'fa-check-circle' : 'fa-exclamation-circle' %>"></i>
                <%= message.text %>
            </div>
        </div>
        <% } %>

            <!-- Add Bootstrap JS and its dependencies -->
            <script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.11.8/dist/umd/popper.min.js"></script>
            <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.min.js"></script>
</body>

</html>